# ==========================================
# Momentum Unified Environment Variables Guide
# ==========================================

# ------------------------------------------
# Backend Variables (Django)
# ------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-momentum-production-ready-secret-key-change-in-prod-2026
ALLOWED_HOSTS=localhost,127.0.0.1,momentum-api.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://momentum-app.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://momentum-app.onrender.com

# PostgreSQL Database URL (Render / Supabase / Neon / RDS)
# If omitted or left empty, Django will automatically use local SQLite (db.sqlite3)
# DATABASE_URL=postgresql://user:password@hostname:5432/momentum_db

# ------------------------------------------
# Frontend Variables (Vite React)
# ------------------------------------------
# For Local Development:
VITE_API_URL=http://127.0.0.1:8000/api
# For Production (Render Static Site / Vercel / Netlify):
# VITE_API_URL=https://<your-backend-domain>.onrender.com/api

