# Momentum Backend Environment Variables
DEBUG=True
SECRET_KEY=django-insecure-momentum-habit-tracker-dev-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production PostgreSQL Database URL (Render / Supabase / Neon / RDS)
# Omit for local development to use SQLite (db.sqlite3) automatically
# DATABASE_URL=postgresql://user:password@hostname:5432/momentum_db

